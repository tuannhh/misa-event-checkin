# Sao chép file này thành .env rồi điền giá trị thật (KHÔNG commit .env lên git).
# Dùng cho chạy local (npm start) - trên Docker/Cloud Run, đặt các biến này trong
# docker-compose.internal.yml hoặc lệnh `gcloud run deploy --set-env-vars`.

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=checkin
DB_PASSWORD=checkinpw
DB_NAME=checkin

# --- Bắt buộc ---
# Ký session đăng nhập. Sinh bằng: openssl rand -hex 32
SESSION_SECRET=

# Tài khoản Super Admin đầu tiên (chỉ dùng lúc DB rỗng để tạo tài khoản)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Khuyến nghị ---
# Mã hoá smtp_pass/brevo_api_key lưu trong DB. Sinh bằng: openssl rand -base64 32
# Nếu để trống, bí mật vẫn hoạt động nhưng lưu ở dạng chữ thường (chỉ chấp nhận được khi dev/local).
ENCRYPTION_KEY=

# --- Tuỳ chọn ---
PORT=3000
# Cần khi gửi email qua Brevo (ảnh header/footer trong email cần URL công khai):
# BASE_URL=https://checkin.vidu.misa.vn
